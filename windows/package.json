{
  "name": "committed-windows",
  "private": true,
  "version": "0.1.50",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "cargo test --manifest-path core/Cargo.toml --locked",
    "tauri": "node scripts/tauri.mjs",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
