          "window": "daily",
          "rank": 1,
          "competitorCount": 2,
          "contributions": 3,
          "above": null,
          "below": { "login": "alice", "contributions": 1 },
          "movementToday": 0,
          "updatedAt": 1800000000
        }
      }
    },
    {
      "name": "no visible rivals shows contributions without a rank",
      "input": {
        "competitors": [{ "login": "me", "isSelf": true }],
        "standings": {
          "me": { "contributions": 6, "window": "daily", "lastUpdated": 1800000000 }
        },
        "window": "daily",
        "rankDeltas": { "me": 0 },
        "now": 1800000300
      },
      "expected": {
        "order": [{ "login": "me", "rank": 1 }],
        "liveRankState": {
          "window": "daily",
          "rank": null,
          "competitorCount": 1,
          "contributions": 6,
          "above": null,
          "below": null,
          "movementToday": 0,
          "updatedAt": 1800000000
        }
      }
    },
    {
      "name": "no data at all falls back to now, rounded down to whole seconds",
      "input": {
        "competitors": [
          { "login": "me", "isSelf": true },
          { "login": "alice", "isSelf": false }
        ],
        "standings": {},
        "window": "monthly",
        "rankDeltas": {},
        "now": 1800000300.75
      },
      "expected": {
        "order": [
          { "login": "me", "rank": 1 },
          { "login": "alice", "rank": 2 }
        ],
        "liveRankState": {
          "window": "monthly",
          "rank": null,
          "competitorCount": 2,
          "contributions": null,
          "above": null,
          "below": null,
          "movementToday": 0,
          "updatedAt": 1800000300
        }
      }
    },
    {
      "name": "fractional lastUpdated rounds down",
      "input": {
        "competitors": [
          { "login": "me", "isSelf": true },
          { "login": "alice", "isSelf": false }
        ],
        "standings": {
          "me": { "contributions": 1, "window": "daily", "lastUpdated": 1800000000.9 },
          "alice": { "contributions": 2, "window": "daily", "lastUpdated": 1800000000.4 }
        },
        "window": "daily",
        "rankDeltas": {},
        "now": 1800000300
      },
      "expected": {
        "order": [
          { "login": "alice", "rank": 1 },
          { "login": "me", "rank": 2 }
        ],
        "liveRankState": {
          "window": "daily",
          "rank": 2,
          "competitorCount": 2,
          "contributions": 1,
          "above": { "login": "alice", "contributions": 2 },
          "below": null,
          "movementToday": 0,
