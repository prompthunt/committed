{
  "version": 1,
  "about": "Shared ranking conformance cases. Consumed by CommitStandingsTests/RankingConformanceTests.swift (Ranking.order + LiveRankState.derive), relay/test/ranking.test.ts (Ranking port + LiveRankState) and windows/core/tests/conformance.rs (order and streaks; Windows has no Live rank). Expected values are worked by hand from the rules in CommitStandings/Store/Ranking.swift: contributions descending, a missing standing (or one for a different window) sorts last below a real 0, ties keep competitor order, ranks start at 1. LiveRankState's movementToday, yours and each neighbor's, is that login's rankDeltas entry on daily and month (This month), else 0. Windows: daily (Today), weekly and monthly (the trailing 7 and 30 days), and month (This month: the 1st of the local month through today, so it starts again at local midnight on the 1st). A case gives either `standings` (counts) or `days` (calendars). With `days` ({login: {YYYY-MM-DD: n}}), `timeZone` and `asOf` (the local day at `now` in `timeZone`), each runner derives standings from the days through its own history code (Swift ContributionHistory, relay sum, Rust history::total), checks `asOf` against its own local-day resolution where it has one, and computes each person's current streak (ContributionHistory.currentStreak: today and the days before it with a contribution; while today has none, counted back from yesterday; a missing or later day never counts). `expected.streaks` lists the raw streak of everyone in `days`; LiveRankState carries `streak` for you (with a count) and each neighbor, and omits it for anyone without a calendar. A login missing from `days` has no data. See relay/README.md#conformance-fixture.",
  "cases": [
    {
      "name": "descending by contributions, self in the middle",
      "input": {
        "self": "me",
        "competitors": ["me", "alice", "bob"],
        "window": "daily",
        "standings": {
          "me": { "contributions": 50, "window": "daily" },
          "alice": { "contributions": 90, "window": "daily" },
          "bob": { "contributions": 20, "window": "daily" }
        },
        "rankDeltas": { "me": 1, "alice": -1 },
        "now": 1793800000
      },
      "expected": {
        "order": [
          { "login": "alice", "rank": 1 },
          { "login": "me", "rank": 2 },
          { "login": "bob", "rank": 3 }
        ],
        "liveRankState": {
          "window": "daily",
          "rank": 2,
          "competitorCount": 3,
          "contributions": 50,
          "above": { "login": "alice", "contributions": 90, "movementToday": -1 },
          "below": { "login": "bob", "contributions": 20, "movementToday": 0 },
          "movementToday": 1,
          "updatedAt": 1793800000
        }
      }
    },
    {
      "name": "ties keep competitor order; movement is 0 outside Today",
      "input": {
        "self": "me",
        "competitors": ["me", "alice", "bob"],
        "window": "weekly",
        "standings": {
          "me": { "contributions": 40, "window": "weekly" },
          "alice": { "contributions": 40, "window": "weekly" },
          "bob": { "contributions": 40, "window": "weekly" }
        },
        "rankDeltas": { "me": 2, "alice": 1 },
        "now": 1793800300
      },
      "expected": {
        "order": [
          { "login": "me", "rank": 1 },
          { "login": "alice", "rank": 2 },
          { "login": "bob", "rank": 3 }
        ],
        "liveRankState": {
          "window": "weekly",
          "rank": 1,
          "competitorCount": 3,
          "contributions": 40,
          "above": null,
          "below": { "login": "alice", "contributions": 40, "movementToday": 0 },
          "movementToday": 0,
          "updatedAt": 1793800300
        }
      }
    },
    {
      "name": "a real zero ranks above missing data; self without data has no rank",
      "input": {
        "self": "me",
        "competitors": ["me", "alice"],
        "window": "weekly",
        "standings": {
          "alice": { "contributions": 0, "window": "weekly" }
        },
        "rankDeltas": {},
        "now": 1793800600
      },
      "expected": {
        "order": [
          { "login": "alice", "rank": 1 },
          { "login": "me", "rank": 2 }
        ],
        "liveRankState": {
          "window": "weekly",
          "rank": null,
          "competitorCount": 2,
          "contributions": null,
          "above": null,
          "below": null,
          "movementToday": 0,
          "updatedAt": 1793800600
        }
      }
    },
    {
      "name": "a standing for another window counts as missing",
      "input": {
        "self": "me",
        "competitors": ["me", "alice"],
        "window": "daily",
        "standings": {
          "me": { "contributions": 10, "window": "daily" },
          "alice": { "contributions": 9999, "window": "monthly" }
        },
        "rankDeltas": {},
        "now": 1793800900
      },
      "expected": {
        "order": [
          { "login": "me", "rank": 1 },
          { "login": "alice", "rank": 2 }
        ],
        "liveRankState": {
          "window": "daily",
          "rank": 1,
          "competitorCount": 2,
          "contributions": 10,
          "above": null,
          "below": null,
          "movementToday": 0,
          "updatedAt": 1793800900
        }
      }
    },
    {
      "name": "no visible rivals: contributions without a rank",
      "input": {
        "self": "me",
        "competitors": ["me"],
        "window": "daily",
        "standings": {
          "me": { "contributions": 7, "window": "daily" }
        },
        "rankDeltas": {},
        "now": 1793801200
      },
      "expected": {
        "order": [
          { "login": "me", "rank": 1 }
        ],
        "liveRankState": {
          "window": "daily",
          "rank": null,
          "competitorCount": 1,
          "contributions": 7,
          "above": null,
          "below": null,
          "movementToday": 0,
          "updatedAt": 1793801200
        }
      }
    },
    {
      "name": "self last on Today, moved down since the baseline",
      "input": {
        "self": "me",
        "competitors": ["me", "alice", "bob"],
        "window": "daily",
        "standings": {
          "me": { "contributions": 1, "window": "daily" },
          "alice": { "contributions": 4, "window": "daily" },
          "bob": { "contributions": 2, "window": "daily" }
        },
        "rankDeltas": { "me": -2, "bob": 1 },
        "now": 1793801500
      },
      "expected": {
        "order": [
          { "login": "alice", "rank": 1 },
          { "login": "bob", "rank": 2 },
          { "login": "me", "rank": 3 }
        ],
        "liveRankState": {
          "window": "daily",
          "rank": 3,
          "competitorCount": 3,
          "contributions": 1,
          "above": { "login": "bob", "contributions": 2, "movementToday": 1 },
          "below": null,
          "movementToday": -2,
          "updatedAt": 1793801500
        }
      }
    },
    {
