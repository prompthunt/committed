        "window": "monthly",
        "standings": {
          "me": { "contributions": 3, "window": "monthly" },
          "alice": { "contributions": 10, "window": "monthly" },
          "bob": { "contributions": 3, "window": "monthly" }
        },
        "rankDeltas": {},
        "now": 1793801800
      },
      "expected": {
        "order": [
          { "login": "alice", "rank": 1 },
          { "login": "me", "rank": 2 },
          { "login": "bob", "rank": 3 },
          { "login": "carol", "rank": 4 }
        ],
        "liveRankState": {
          "window": "monthly",
          "rank": 2,
          "competitorCount": 4,
          "contributions": 3,
          "above": { "login": "alice", "contributions": 10, "movementToday": 0 },
          "below": { "login": "bob", "contributions": 3, "movementToday": 0 },
          "movementToday": 0,
          "updatedAt": 1793801800
        }
      }
    },
    {
      "name": "you win a tie with a rival: you're first on your own board",
      "input": {
        "self": "me",
        "competitors": ["me", "alice", "bob"],
        "window": "daily",
        "standings": {
          "me": { "contributions": 5, "window": "daily" },
