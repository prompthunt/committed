          "window": "daily",
          "rank": 2,
          "competitorCount": 3,
          "contributions": 5,
          "above": { "login": "bob", "contributions": 6, "movementToday": 0 },
          "below": { "login": "alice", "contributions": 5, "movementToday": 0 },
          "movementToday": 0,
          "updatedAt": 1793802100
        }
      }
    },
    {
      "name": "streaks: alive on yesterday's work, a later day never counts, no calendar means no streak",
      "input": {
        "self": "me",
        "competitors": ["me", "alice", "bob", "cara"],
        "window": "weekly",
        "timeZone": "UTC",
        "asOf": "2026-11-10",
        "now": 1794322800,
        "rankDeltas": {},
        "days": {
          "me": {
            "2026-11-03": 7,
            "2026-11-04": 5,
            "2026-11-05": 4,
            "2026-11-06": 0,
            "2026-11-07": 3,
            "2026-11-08": 1,
            "2026-11-09": 2,
            "2026-11-10": 0
          },
          "alice": {
            "2026-11-05": 20,
            "2026-11-06": 1,
            "2026-11-07": 1,
            "2026-11-08": 1,
            "2026-11-09": 1,
            "2026-11-10": 1,
            "2026-11-11": 9
          },
          "bob": { "2026-11-08": 6, "2026-11-09": 0, "2026-11-10": 0 }
        }
      },
      "expected": {
        "order": [
          { "login": "alice", "rank": 1 },
          { "login": "me", "rank": 2 },
          { "login": "bob", "rank": 3 },
          { "login": "cara", "rank": 4 }
        ],
        "streaks": { "me": 3, "alice": 6, "bob": 0 },
        "liveRankState": {
          "window": "weekly",
          "rank": 2,
          "competitorCount": 4,
          "contributions": 15,
          "above": { "login": "alice", "contributions": 25, "movementToday": 0, "streak": 6 },
          "below": { "login": "bob", "contributions": 6, "movementToday": 0, "streak": 0 },
          "movementToday": 0,
          "streak": 3,
          "updatedAt": 1794322800
        }
      }
    },
    {
      "name": "streaks: a non-UTC time zone decides which day is today",
      "input": {
        "self": "me",
        "competitors": ["me", "kai", "lu"],
        "window": "daily",
        "timeZone": "America/Los_Angeles",
        "asOf": "2026-11-09",
        "now": 1794286800,
        "rankDeltas": { "me": -1, "lu": 1 },
        "days": {
          "me": { "2026-11-08": 2, "2026-11-09": 3 },
          "kai": { "2026-11-06": 1, "2026-11-07": 1, "2026-11-08": 4, "2026-11-09": 0 },
          "lu": { "2026-11-08": 0, "2026-11-09": 5 }
        }
      },
      "expected": {
        "order": [
          { "login": "lu", "rank": 1 },
          { "login": "me", "rank": 2 },
          { "login": "kai", "rank": 3 }
        ],
        "streaks": { "me": 2, "kai": 3, "lu": 1 },
        "liveRankState": {
          "window": "daily",
          "rank": 2,
          "competitorCount": 3,
          "contributions": 3,
          "above": { "login": "lu", "contributions": 5, "movementToday": 1, "streak": 1 },
          "below": { "login": "kai", "contributions": 0, "movementToday": 0, "streak": 3 },
          "movementToday": -1,
          "streak": 2,
          "updatedAt": 1794286800
        }
      }
    },
    {
